 522, "y2": 299, "score": 0.998}, {"text": "第1讲加乘原理初步 第14讲等积变形", "x": 103, "y": 416, "x2": 675, "y2": 452, "score": 0.996}, {"text": "第2讲 三角形初步", "x": 103, "y": 461, "x2": 282, "y2": 485, "score": 1.0}, {"text": "好方法1等积变形（1）/3", "x": 487, "y": 484, "x2": 709, "y2": 509, "score": 0.995}, {"text": "第3讲 三角形进阶", "x": 103, "y": 505, "x2": 283, "y2": 531, "score": 1.0}, {"text": "好方法2等积变形（2）/7", "x": 487, "y": 524, "x2": 708, "y2": 548, "score": 0.997}, {"text": "第4讲小数的计算 好方法3等积变形（3）/11", "x": 101, "y": 549, "x2": 714, "y2": 586, "score": 0.998}, {"text": "第5讲 等差数列进阶 好方法4等积变形（4）/15", "x": 103, "y": 589, "x2": 715, "y2": 622, "score": 0.998}, {"text": "第6讲 相遇问题 好方法5正方形的等积变形（1）/19", "x": 103, "y": 633, "x2": 787, "y2": 663, "score": 0.998}, {"text": "第7讲追及问题 好方法6正方形的等积变形（2）/23", "x": 103, "y": 678, "x2": 786, "y2": 702, "score": 0.974}, {"text": "第8讲 整除特征初步 第15讲 一半模型", "x": 103, "y": 722, "x2": 659, "y2": 749, "score": 0.998}, {"text": "第9讲逻辑推理综合（2） 第16讲 最值问题初步", "x": 102, "y": 767, "x2": 697, "y2": 793, "score": 0.998}, {"text": "第10讲定义新运算初步 第17讲 数阵图初步", "x": 102, "y": 812, "x2": 678, "y2": 838, "score": 0.999}, {"text": "第11讲体育比赛中的数学问题 第18讲 平均数进阶", "x": 103, "y": 858, "x2": 679, "y2": 882, "score": 0.999}, {"text": "第12讲几何计数初步 第19讲 破译乘除法竖式", "x": 103, "y": 902, "x2": 717, "y2": 927, "score": 0.989}, {"text": "第13讲多位数计算 第20讲 环形跑道问题", "x": 103, "y": 947, "x2": 697, "y2": 972, "score": 0.999}, {"text": "参考答案", "x": 485, "y": 991, "x2": 570, "y2": 1018, "score": 0.999}]}, "5": {"size": [849, 1159], "lines": [{"text": "第14讲等积变形", "x": 633, "y": 21, "x2": 781, "y2": 41, "score": 0.997}, {"text": "等积变形", "x": 308, "y": 152, "x2": 517, "y2": 208, "score": 0.995}, {"text": "一天同学们去农场玩。", "x": 69, "y": 290, "x2": 232, "y2": 310, "score": 1.0}, {"text": "风和日丽", "x": 631, "y": 476, "x2": 733, "y2": 496, "score": 0.999}, {"text": "农场有一块平行四边形的草场分成", "x": 436, "y": 569, "x2": 698, "y2": 590, "score": 1.0}, {"text": "A，B，C，D四个三角形，草均匀", "x": 434, "y": 602, "x2": 689, "y2": 622, "score": 0.998}, {"text": "生长，A场可以供35头牛吃一天，", "x": 436, "y": 631, "x2": 682, "y2": 651, "score": 1.0}, {"text": "B场可以供80头牛吃一天，C场可", "x": 432, "y": 659, "x2": 685, "y2": 683, "score": 0.999}, {"text": "以供45头牛吃一天，那么D场呢？", "x": 433, "y": 689, "x2": 685, "y2": 713, "score": 0.998}, {"text": "知识导引", "x": 99, "y": 834, "x2": 245, "y2": 878, "score": 0.998}, {"text": "1.平行线间的等积原理；", "x": 124, "y": 959, "x2": 359, "y2": 987, "score": 0.999}, {"text": "2.等底等高的三角形。", "x": 123, "y": 995, "x2": 337, "y2": 1024, "score": 1.0}]}, "6": {"size": [849, 1159], "lines": [{"text": "学而思秘籍小学数学思维培养7级", "x": 111, "y": 33, "x2": 390, "y2": 58, "score": 0.991}, {"text": "知识点梳理", "x": 125, "y": 167, "x2": 306, "y2": 207, "score": 0.995}, {"text": "一、三角形面积=底×高÷2。", "x": 166, "y": 292, "x2": 442, "y2": 320, "score": 0.981}, {"text": "二、等高：面积的倍数关系=底的倍数关系；等底：面积的", "x": 163, "y": 344, "x2": 711, "y2": 375, "score": 0.996}, {"text": "倍数关系=高的倍数关系；等底等高：面积相等。", "x": 195, "y": 400, "x2": 655, "y2": 427, "score": 0.997}, {"text": "因为AD平行于BC，所以S△ABC=S△DBC，S△ADB=", "x": 193, "y": 611, "x2": 705, "y2": 640, "score": 0.96}, {"text": "S△ADc（等底等高）,S△AOB=S△DOC（差不变）。", "x": 194, "y": 668, "x2": 618, "y2": 694, "score": 0.933}, {"text": "三、几个正方形并排放", "x": 160, "y": 720, "x2": 375, "y2": 750, "score": 0.998}, {"text": "作辅助线常用的方法：连接同向的对角线。", "x": 196, "y": 779, "x2": 596, "y2": 799, "score": 0.999}]}, "7": {"size": [849, 1160], "lines": [{"text": "第14讲等积变形", "x": 634, "y": 22, "x2": 783, "y2": 45, "score": 0.989}, {"text": "好方法1", "x": 73, "y": 96, "x2": 212, "y2": 140, "score": 0.98}, {"text": "等积变形（1）", "x": 277, "y": 188, "x2": 441, "y2": 219, "score": 0.977}, {"text": "等底等高：面积相等", "x": 278, "y": 221, "x2": 484, "y2": 251, "score": 1.0}, {"text": "APP扫码观看知识点典题精讲", "x": 239, "y": 321, "x2": 535, "y2": 349, "score": 1.0}, {"text": "典题精讲", "x": 81, "y": 436, "x2": 198, "y2": 470, "score": 0.992}, {"text": "【例1】", "x": 70, "y": 497, "x2": 138, "y2": 523, "score": 0.997}, {"text": "(1)如图，BD长12厘米，DC长4厘米，B、C和D在同一条直线", "x": 118, "y": 529, "x2": 758, "y2": 555, "score": 0.975}, {"text": "上。求三角形ABD的面积是三角形ADC面积的多少倍。", "x": 74, "y": 564, "x2": 636, "y2": 589, "score": 1.0}, {"text": "B D", "x": 346, "y": 729, "x2": 443, "y2": 747, "score": 0.996}, {"text": "(2)如图，E在AD上，AD垂直BC于D，AD=12厘米，DE=3厘", "x": 119, "y": 757, "x2": 759, "y2": 783, "score": 0.96}, {"text": "米。求三角形ABC的面积是三角形EBC面积的几倍。", "x": 75, "y": 792, "x2": 608, "y2": 817, "score": 1.0}]}, "8": {"size": [849, 1160], "lines": [{"text": "学而思秘籍小学数学思维培养7级", "x": 111, "y": 35, "x2": 389, "y2": 62, "score": 0.994}, {"text": "思维导图", "x": 121, "y": 158, "x2": 228, "y2": 189, "score": 0.996}, {"text": "三角形ABD面积 三角形ADC面积", "x": 377, "y": 225, "x2": 682, "y2": 252, "score": 0.994}, {"text": "BD×高÷2 DC×高÷2", "x": 393, "y": 292, "x2": 665, "y2": 313, "score": 0.899}, {"text": "按照导图一步一步 等高", "x": 108, "y": 353, "x2": 550, "y2": 381, "score": 0.994}, {"text": "寻找解题思路。", "x": 106, "y": 380, "x2": 213, "y2": 407, "score": 0.997}, {"text": "面积的倍数=底的倍数", "x": 446, "y": 410, "x2": 611, "y2": 435, "score": 0.99}, {"text": "三角形ABC面积 三角形EBC面积", "x": 449, "y": 451, "x2": 754, "y2": 476, "score": 0.992}, {"text": "BCXAD÷2 BCXED÷2", "x": 465, "y": 512, "x2": 744, "y2": 533, "score": 0.938}, {"text": "等底", "x": 582, "y": 571, "x2": 623, "y2": 597, "score": 0.991}, {"text": "面积的倍数=高的倍数", "x": 518, "y": 627, "x2": 685, "y2": 653, "score": 0.993}, {"text": "【解析】", "x": 87, "y": 661, "x2": 160, "y2": 685, "score": 0.996}, {"text": "（1)因为三角形ABD，三角形ABC和三角形ADC在分别以BD，", "x": 136, "y": 691, "x2": 774, "y2": 716, "score": 0.983}, {"text": "BC和DC为底时，它们的高都是从A点向BC边上所作的垂线，也就", "x": 89, "y": 721, "x2": 774, "y2": 747, "score": 0.999}, {"text": "是说三个三角形的高相等。于是：三角形ABD的面积=12×高÷2=6", "x": 89, "y": 751, "x2": 775, "y2": 777, "score": 0.986}, {"text": "×高；三角形ADC的面积=4×高÷2=2×高，所以，三角形ABD的面", "x": 90, "y": 781, "x2": 774, "y2": 807, "score": 0.962}, {"text": "积是三角形ADC面积的3倍。", "x": 89, "y": 812, "x2": 386, "y2": 837, "score": 1.0}, {"text": "（2)因为AD垂直于BC，所以当BC为三角形ABC和三角形EBC", "x": 135, "y": 843, "x2": 773, "y2": 868, "score": 0.98}, {"text": "的底时，AD是三角形ABC的高，ED是三角形EBC的高，于是：三角", "x": 89, "y": 873, "x2": 772, "y2": 898, "score": 0.998}, {"text": "形ABC的面积=BC×12÷2；三角形EBC的面积=BC×3÷2,所以", "x": 89, "y": 904, "x2": 774, "y2": 928, "score": 0.969}, {"text": "三角形ABC的面积是三角形EBC面积的4倍。", "x": 89, "y": 933, "x2": 556, "y2": 959, "score": 1.0}, {"text": "学习笔记", "x": 148, "y": 1011, "x2": 253, "y2": 1042, "score": 0.998}]}, "9": {"size": [849, 1159], "lines": [{"text": "第14讲等积变形", "x": 634, "y": 18, "x2": 783, "y2": 41, "score": 0.989}, {"text": "举一反三 拍照批改秒判对错", "x": 78, "y": 89, "x2": 483, "y2": 120, "score": 0.999}, {"text": "练习1", "x": 58, "y": 150, "x2": 127, "y2": 178, "score": 0.991}, {"text": "在三角形ABC中，E、F分别为AB和AC的中点，那么三角形ABC", "x": 103, "y": 182, "x2": 767, "y2": 210, "score": 0.996}, {"text": "的面积是三角形BEF面积的多少倍？", "x": 61, "y": 219, "x2": 425, "y2": 242, "score": 0.999}, {"text": "APP", "x": 645, "y": 345, "x2": 676, "y2": 359, "score": 0.991}, {"text": "练习2", "x": 59, "y": 605, "x2": 126, "y2": 630, "score": 0.999}, {"text": "如图，已知△ABE的面积为1平方厘米，BC=BE，AD=AB，求", "x": 105, "y": 638, "x2": 767, "y2": 663, "score": 0.967}, {"text": "△DCB的面积。", "x": 58, "y": 670, "x2": 222, "y2": 699, "score": 0.947}, {"text": "APP扫码看讲解", "x": 641, "y": 797, "x2": 766, "y2": 817, "score": 0.995}]}, "10": {"size": [849, 1159], "lines": [{"text": "学而思秘籍小学数学思维培养7级", "x": 111, "y": 33, "x2": 388, "y2": 56, "score": 0.993}, {"text": "挑战自我 拍照批改秒判对错", "x": 99, "y": 96, "x2": 502, "y2": 124, "score": 0.998}, {"text": "练习3", "x": 81, "y": 156, "x2": 146, "y2": 181, "score": 0.999}, {"text": "牛牛的叔叔是一名著名的铁匠，周末到了，牛牛带着丁丁和田田一起", "x": 126, "y": 189, "x2": 787, "y2": 215, "score": 0.998}, {"text": "给叔叔帮忙，刚到铁匠铺，牛牛就接到了一位顾客的工作，需要他按照图", "x": 80, "y": 223, "x2": 785, "y2": 249, "score": 0.998}, {"text": "纸进行切割。如图，图中的小正方形边长是40厘米，则阴影部分面积是多", "x": 81, "y": 259, "x2": 785, "y2": 282, "score": 1.0}, {"text": "少平方厘米？", "x": 78, "y": 289, "x2": 208, "y2": 318, "score": 0.986}]}, "11": {"size": [849, 1162], "lin